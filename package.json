{
  "name": "larosentry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.21.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "setup:check": "node scripts/check.mjs",
    "services:up": "node scripts/services.mjs up",
    "services:down": "node scripts/services.mjs down",
    "db:generate": "pnpm --filter @larosentry/api db:generate",
    "db:migrate": "pnpm --filter @larosentry/api db:migrate",
    "db:seed": "pnpm --filter @larosentry/api db:seed",
    "demo:account": "pnpm --filter @larosentry/api demo:account",
    "admin:access": "pnpm --filter @larosentry/api admin:access",
    "dev": "pnpm -r --parallel --filter @larosentry/api --filter @larosentry/web dev",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "eslint apps packages scripts tests",
    "format": "prettier --write apps packages scripts docs tests *.json *.yaml",
    "test": "vitest run",
    "test:integration": "node scripts/test-database.mjs",
    "test:demo-mode": "node scripts/test-database.mjs demo-verification",
    "test:e2e": "playwright test",
    "test:admin:e2e": "node scripts/test-database.mjs browser-admin",
    "test:onboarding:e2e": "node scripts/test-database.mjs browser-onboarding",
    "test:scheduler:e2e": "node scripts/test-database.mjs browser-scheduler",
    "test:responsive:e2e": "node scripts/test-database.mjs browser-responsive",
    "db:backup": "node scripts/backup.mjs backup",
    "db:restore:test": "node scripts/backup.mjs restore",
    "demo:setup": "node scripts/demo.mjs setup",
    "demo:start": "node scripts/demo.mjs start",
    "demo:scenarios": "node scripts/demo.mjs scenarios"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4"
  }
}
