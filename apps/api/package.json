{
  "name": "@larosentry/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/seed.ts",
    "demo:account": "tsx src/bootstrap.ts",
    "admin:access": "tsx src/admin-bootstrap.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration.test.ts test/admin.test.ts test/scheduler.test.ts test/workspaces.test.ts test/onboarding.test.ts"
  },
  "dependencies": {
    "@larosentry/contracts": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "express-rate-limit": "8.3.0",
    "helmet": "8.1.0",
    "nodemailer": "10.1.0",
    "otplib": "13.5.0",
    "pg": "8.20.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.18.0",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.15"
  }
}
