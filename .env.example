NODE_ENV=development
DEMO_MODE=false
# Opt in only through the dedicated local demo launcher; never use on public hosting.
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://larosentry_app:REPLACE@127.0.0.1:5432/larosentry
DATA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=LaroSentry <hello@larosentry.test>
SMS_PROVIDER=unavailable
# For loopback local testing only: SMS_PROVIDER=local
# Configure your HTTPS SMS gateway adapter before using SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=
SMS_API_KEY=
VERIFICATION_ID_TYPES=Philippine National ID,Passport,Driver’s License,UMID,PRC ID
